# Copy this file to .env and fill it in. Never commit .env.

# Discord bot token (Developer Portal -> your app -> Bot -> Token)
DISCORD_TOKEN=

# DigitalOcean managed Postgres connection string (same value as MLEBB's .env).
# Database must be sprocket_main (it has the mledb + sprocket schemas).
connstring=postgresql://user:password@host:25060/sprocket_main?sslmode=require

# Season treated as "current". Remove/blank to auto-use the latest started season.
CURRENT_SEASON=20

# --- Optional -------------------------------------------------------------
# Extra admins besides members with the Administrator permission (comma-separated IDs).
# ADMIN_USER_IDS=123456789012345678
# ADMIN_ROLE_IDS=

# Emojis by server emoji name (:Name:), resolved in the server the bot posts in.
# Set a league emoji to an empty value to show plain text (**ML**) instead.
# EMOJI_ML=:ML:
# EMOJI_CL=:CL:
# EMOJI_AL=:AL:
# EMOJI_FL=:FL:
# EMOJI_WIN=:FlamesDub:
# EMOJI_LOSS=:FeelsFlames:

# Display timezone (default Eastern). Salary snapshots use SALARY_TZ (Pacific).
# DISPLAY_TZ=America/New_York

# Timezone for the "eligible as of Monday 00:00" cutoff (default Eastern).
# ELIGIBILITY_TZ=America/New_York

# EVIDENCE_URL_TEMPLATE=https://evidence.mlesports.gg/matchups/{match_id}/
